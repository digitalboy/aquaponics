# 倍控 N100 边缘视频 Agent 环境变量模板
VIDEO_GATEWAY_URL=https://aquaponics-video-gateway.<your-subdomain>.workers.dev
SITE_ID=guangming-01
AGENT_SECRET=replace-with-strong-hmac-secret

# 内存盘路径（严禁指向 128G 系统 SSD）
HLS_RAM_DIR=/mnt/hls_ram
RAM_LIMIT_MB=512
RAM_HIGH_WATER_RATIO=0.80

# 本地 MediaMTX 复用地址
MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554

# 4G 默认省流抓拍间隔（秒）
SNAPSHOT_INTERVAL_SEC=600
HEARTBEAT_IDLE_SEC=10
HEARTBEAT_ACTIVE_SEC=3

# 激活机位列表（逗号分隔，与 D1 cameras 表对齐）
ACTIVE_CAMERAS=CAM-GATE-IN-01,CAM-GATE-OUT-01,CAM-BACK-IN-01,CAM-FISH-PAN-01,CAM-FISH-P5-01,CAM-HYDRO-PAN-01,CAM-EQUIP-IN-01
